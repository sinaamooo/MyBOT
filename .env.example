# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx
ADMIN_IDS=123456789,987654321

# Binance (public market data works without keys; keys only needed for
# authenticated endpoints such as Open Interest history on some plans)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Trading mode: paper (simulate + publish signals) | signal_only (publish only, no simulated PnL tracking)
# "live" is intentionally not supported by this bot - it never places real orders.
TRADING_MODE=paper

LOG_LEVEL=INFO
