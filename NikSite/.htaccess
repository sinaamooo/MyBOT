# Numbix — Apache / LiteSpeed configuration
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    # If the site lives in a sub-folder and links break, uncomment and set it:
    # RewriteBase /numbix/

    # Block direct access to private folders and files
    RewriteRule ^(app|storage)(/|$) - [F,L]
    RewriteRule ^(config\.php|config\.sample\.php|cron\.php|install/schema\.sql)$ - [F,L]

    # Front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|svg|png|jpe?g|webp|gif|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
