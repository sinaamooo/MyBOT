# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx
ADMIN_IDS=123456789,987654321

# Random secret string - used to verify incoming webhook requests really
# come from Telegram (sent back as X-Telegram-Bot-Api-Secret-Token header).
# Generate any long random string, e.g.: php -r "echo bin2hex(random_bytes(20));"
TELEGRAM_WEBHOOK_SECRET=

# Full public HTTPS URL to public/webhook.php on your domain, e.g.
# https://yourdomain.com/crypto-signal-bot/public/webhook.php
TELEGRAM_WEBHOOK_URL=

# Database - defaults to SQLite: a single file, created automatically on
# first run, nothing to set up. DB_PATH is relative to the project root
# unless it starts with "/".
DB_DRIVER=sqlite
DB_PATH=data/bot.sqlite

# Only used when DB_DRIVER=mysql (create the database via cPanel -> MySQL
# Databases first, and import sql/schema.sql via phpMyAdmin)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Exchange - public MEXC Futures REST API, no key needed, no geo-restrictions
EXCHANGE_ID=mexc
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# paper (default) or signal_only - this bot never places real orders
TRADING_MODE=paper

LOG_LEVEL=INFO
