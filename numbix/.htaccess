# Numbix — block direct downloads of secrets, databases and logs.
# The bot only needs these to be reachable from the web:
#   bot_master_membership.php (webhook + mini-app), admin_panel.php, monitor.php, assets/
Options -Indexes

<FilesMatch "(^\.|\.(sqlite|sqlite3|sqlite-wal|sqlite-shm|db|json|log|md|bak|tmp|lock|ini|sh|sql|zip|tar|gz|env)$|^config\.(local|sample)\.php$|^error_log$|^php_errors\.log)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_alias.c>
  RedirectMatch 404 (?i)/(data_master|modules)(/|$)
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
</IfModule>
