Options -Indexes
<IfModule mod_authz_core.c>
    Require all denied
    <Files "bot.php">
        Require all granted
    </Files>
    <Files "setup.php">
        Require all granted
    </Files>
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <Files "bot.php">
        Allow from all
    </Files>
    <Files "setup.php">
        Allow from all
    </Files>
</IfModule>
