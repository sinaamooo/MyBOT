# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx
ADMIN_IDS=123456789,987654321

# Exchange (any ccxt id that supports linear USDT-M perpetual futures)
# mexc = default, no geo-restrictions, no keys needed for public market data
# other options: kucoinfutures, binanceusdm (blocked in some regions)
EXCHANGE_ID=mexc
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Trading mode: paper (simulate + publish signals) | signal_only (publish only, no simulated PnL tracking)
# "live" is intentionally not supported by this bot - it never places real orders.
TRADING_MODE=paper

LOG_LEVEL=INFO
