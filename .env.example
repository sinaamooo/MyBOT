# ===== Required =====
BOT_TOKEN=123456789:AA...your-token...
# Comma separated numeric IDs of bot admins
ADMIN_IDS=6595849261

# ===== Optional =====
# Main channel link shown under every answer (can also be set from /panel)
CHANNEL_URL=https://t.me/your_channel
# Proxy for Telegram + APIs (http://host:port or socks5://user:pass@host:port) - useful on Iranian servers
PROXY=
TELEGRAM_PROXY=
DB_PATH=data/bot.db
LOG_LEVEL=INFO

# API keys only raise rate limits; everything works without them
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
TRONSCAN_API_KEY=
TONAPI_KEY=
TONCENTER_API_KEY=
COINGECKO_API_KEY=
WHALE_ALERT_API_KEY=
# Portals market auth ("tma query_id=...") for live gift floors (optional)
PORTALS_AUTH=
# my.telegram.org credentials so /gift @username works for ANY user (optional)
API_ID=
API_HASH=
