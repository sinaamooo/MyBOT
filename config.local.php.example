<?php
/**
 * 🔑 نمونه‌ی فایل کلیدها.
 *
 * این را کپی کنید به config.local.php و مقدارها را عوض کنید.
 * config.local.php داخل .gitignore است، پس هیچ‌وقت وارد گیت نمی‌شود
 * و هیچ کلیدی از سورس بیرون نمی‌زند.
 *
 * ⚠️ بدون این فایل (یا متغیرهای محیطی معادلش) ربات عمدا بالا نمی‌آید —
 * چون سورسی که توکن دارد یعنی هرکس فایل را گرفت، ربات را هم گرفت.
 *
 * هر define با defined() محافظت شده تا اگر جایی از قبل تعریف شده باشد
 * PHP اخطار چاپ نکند؛ یک اخطارِ چاپ‌شده می‌تواند جوابِ وبهوک را خراب
 * کند یا مسیر فایل‌های سرور را لو بدهد.
 */

// توکن ربات مادر — از @BotFather
if (!defined('BOT_TOKEN'))        define('BOT_TOKEN', 'توکن-ربات-را-اینجا-بگذارید');

// شناسه عددی خودتان
if (!defined('ADMIN_ID'))         define('ADMIN_ID', 123456789);

// رمز ورود پنل وب — حداقل ۶ کاراکتر، وگرنه پنل باز نمی‌شود
if (!defined('ADMIN_PANEL_PASS')) define('ADMIN_PANEL_PASS', 'رمز-پنل-را-عوض-کنید');

// کلید آدرس cron — حداقل ۱۲ کاراکتر تصادفی
if (!defined('CRON_KEY'))         define('CRON_KEY', 'یک-رشته-تصادفی-بلند');

// کلید باز کردن health.php — حداقل ۱۶ کاراکتر تصادفی، وگرنه آن صفحه ۴۰۴ می‌دهد
if (!defined('HEALTH_KEY'))       define('HEALTH_KEY', 'یک-رشته-تصادفی-بلند-دیگر');

/**
 * کلیدهای تصادفی را با این دستور بسازید:
 *   php -r "echo bin2hex(random_bytes(16));"
 */
