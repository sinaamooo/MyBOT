# ------------------------------------------------------------------
# Telegram Premium Emoji Maker - environment configuration
# Copy this file to ".env" (same folder, OUTSIDE the public web root)
# and fill in the values. Never commit the real .env file.
# ------------------------------------------------------------------

APP_NAME="Emoji Maker"
APP_ENV=production
APP_DEBUG=false
# Public HTTPS address of the "public" folder (no trailing slash)
APP_URL=https://emoji.example.com
# 32-byte random key, generated by bin/install.php (base64:...)
APP_KEY=
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa

# ---------------- Database (MySQL 5.7+ / MariaDB 10.3+) ----------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=emoji_maker
DB_USER=emoji_maker
DB_PASS=
# Optional unix socket (leave empty to use host/port)
DB_SOCKET=
DB_CHARSET=utf8mb4

# ---------------- Telegram ----------------
# Token from @BotFather. Keep it ONLY here (or set it encrypted from the admin panel).
TELEGRAM_BOT_TOKEN=
# Bot username without @ (auto-detected with getMe when empty)
TELEGRAM_BOT_USERNAME=
# Secret sent by Telegram in X-Telegram-Bot-Api-Secret-Token (A-Z a-z 0-9 _ -)
TELEGRAM_WEBHOOK_SECRET=
# Numeric Telegram user IDs that have bot-admin rights (comma separated)
TELEGRAM_ADMIN_IDS=
# Only change for a local Bot API server or for tests
TELEGRAM_API_BASE=https://api.telegram.org
# Reject webhook calls that do not come from Telegram's published IP ranges
TELEGRAM_IP_CHECK=false
# inline = handle updates right after answering Telegram (default)
# queue  = store updates and let the worker process them (very busy bots)
WEBHOOK_MODE=inline

# ---------------- Storage ----------------
# Absolute path recommended; MUST NOT be inside the public web root.
# Empty = <project>/storage
STORAGE_PATH=

# ---------------- External tools ----------------
# Leave empty for auto-detection in PATH
FFMPEG_PATH=
FFPROBE_PATH=
# Niceness applied to ffmpeg (0 = disabled)
PROCESS_NICE=10
# Max seconds for a single external process
PROCESS_TIMEOUT=120

# ---------------- Worker ----------------
WORKER_MAX_PARALLEL=2
WORKER_MEMORY_LIMIT=512M

# ---------------- Admin panel ----------------
# auto = secure cookies when the request is HTTPS
SESSION_SECURE=auto
ADMIN_SESSION_LIFETIME=7200
